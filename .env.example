# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Two URLs for one database, and it matters which is which. Neon's Vercel
# integration injects both automatically in deployed environments — you only
# need these locally.

# Pooled (host contains `-pooler`). The app's reads go here: the connection
# pooler is what lets many short-lived function instances share a small number
# of Postgres backends.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Direct (same host, without `-pooler`). Used by drizzle-kit and by the TACO
# ingest. DDL and long transactions do not belong on a pooler — in transaction
# pooling mode a session-level statement can land on a different backend than
# the one that opened the transaction.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-123456.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Hardening, optional and recommended: point DATABASE_URL at a Neon role with
# only SELECT on the public schema. The app never writes — every table in this
# database is reference data loaded by the ingest — so a read-only role costs
# nothing and turns "the app cannot corrupt the catalogue" from a code review
# into a database grant. Keep DATABASE_URL_UNPOOLED as the owner so migrations
# and the ingest still work.
#
#   CREATE ROLE dietkit_reader WITH LOGIN PASSWORD '...';
#   GRANT USAGE ON SCHEMA public TO dietkit_reader;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO dietkit_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT TO dietkit_reader;
#
# Nothing here is personal data, so nothing here is a privacy risk if it leaks:
# profiles, weights, diets and settings never reach this database (§ D1).

# --- Accounts (#93, § D24) -------------------------------------------------
#
# Optional. Without these two the app runs exactly as it always has, signed out,
# and /api/auth answers 503 — which is a supported state, not a broken one. An
# account exists to move data between devices; it is never the price of using
# the app.
#
# Auth is enabled per **branch**, not per project: each Neon branch gets its own
# auth service, its own URL and its own users. A branch created from another
# inherits a copy of its users at that moment and then diverges, so an account
# made on preview does not exist in production and vice versa — which is what
# makes preview a safe place to test sign-up while #97 (delete account) is still
# open. Enable it per branch: Project -> Branch -> Auth -> Enable Auth.
#
# The service is deployed in the database's region, so accounts stay in
# Frankfurt with everything else (§ D22). Copy the URL the console prints
# whole: it has a path on the end, and dropping it gives 404s that look like a
# broken proxy route.
NEON_AUTH_BASE_URL="https://ep-example-123456.neonauth.c-5.eu-central-1.aws.neon.tech/neondb/auth"

# Trusted domains, set in the console next to the switch above, are not
# cosmetic and are not only about reset links: the service answers 403
# INVALID_ORIGIN to *every* call whose origin is not on the list. Any localhost
# port is allowed automatically, which is why a local run needs none and a
# deployed one does not work at all until its domain is added.
#
# A wildcard has to be a whole leftmost label -- `https://*.example.com` is
# accepted, `https://app-*.example.com` is rejected. Vercel preview URLs cannot
# use one: `dietkit-git-some-branch-scope.vercel.app` is a single label under
# `vercel.app`, so the only wildcard that would match is `https://*.vercel.app`,
# which trusts every site anybody has ever deployed to Vercel. Do not add it.
#
# So: the production domain on the production branch, and on the preview branch
# the stable per-branch alias of whatever is being tested
# (`https://<project>-git-<branch>-<scope>.vercel.app`), added when that branch
# is worth testing deployed. Everything else is tested on localhost, which needs
# no configuration.
#
# `npm run db:audit:accounts` prints the list, along with which sender delivers
# those emails and every column the auth schema currently has.

# Signs the session cookie. At least 32 characters, and different per
# environment — a shared secret means a preview deployment can mint a session
# cookie production will accept. Generate one with:
#
#   openssl rand -base64 32
#
# This is the only auth secret this app holds. The sync passphrase (#94) is not
# here and has no column anywhere on the server (§ D23): it never leaves the
# device, which is what makes "end-to-end encrypted" a claim rather than a word.
NEON_AUTH_COOKIE_SECRET="replace-me-with-at-least-32-random-characters"
